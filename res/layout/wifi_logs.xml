<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <TextView android:id="@+id/wifi_log_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="12dp" android:textAppearance="@style/WifiCaption" android:maxLines="2" android:ellipsize="end" />
        <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/wifi_log_follow"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/wifi_log_follow" android:checked="true" app:buttonTint="@color/system_accent" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/wifi_log_scroll" style="@style/Tech.Card"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:padding="12dp">
        <TextView android:id="@+id/wifi_log_output" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="13sp" android:textColor="@color/md_theme_dark_onSurface"
            android:textIsSelectable="true" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
