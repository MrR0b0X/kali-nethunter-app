<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.tabs.TabLayout android:id="@+id/wifi_session_tabs"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:tabTextColor="@color/system_tab_text" app:tabSelectedTextColor="@color/system_accent"
        app:tabIndicatorColor="@color/system_accent" />
    <androidx.viewpager2.widget.ViewPager2 android:id="@+id/wifi_session_pager"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" />
    <LinearLayout android:id="@+id/wifi_session_footer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp" android:background="@color/hightech_card">
        <TextView android:id="@+id/wifi_session_footer_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge" android:accessibilityLiveRegion="polite" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
            <com.google.android.material.button.MaterialButton android:id="@+id/wifi_session_back"
                style="@style/Tech.Button.Outlined" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:minHeight="56dp"
                android:text="@string/wifi_session_background" />
            <com.google.android.material.button.MaterialButton android:id="@+id/wifi_session_stop"
                style="@style/Tech.Button.Primary" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:layout_marginStart="6dp" android:minHeight="56dp"
                android:text="@string/wifi_stop" app:icon="@drawable/ic_action_stop" app:iconGravity="textStart" />
            <com.google.android.material.button.MaterialButton android:id="@+id/wifi_session_captures"
                style="@style/Tech.Button.Primary" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:layout_marginStart="6dp" android:minHeight="56dp"
                android:text="@string/wifi_session_captures" app:icon="@drawable/baseline_folder_open_24" app:iconGravity="textStart" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
