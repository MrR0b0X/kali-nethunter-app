<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Tech.Card" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="0dp">
    <ScrollView android:id="@+id/wifi_target_scroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <FrameLayout android:layout_width="64dp" android:layout_height="64dp"
                android:layout_gravity="center_horizontal" android:background="@drawable/bg_card_tech">
                <ImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center"
                    android:importantForAccessibility="no" android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_action_network_wifi" app:tint="@color/system_accent" />
            </FrameLayout>
            <TextView android:id="@+id/wifi_target_ssid" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge" android:textStyle="bold"
                android:textIsSelectable="true" />
            <TextView android:id="@+id/wifi_target_bssid" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center"
                android:fontFamily="monospace" android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/system_tab_text" android:textIsSelectable="true" />
            <TextView android:id="@+id/wifi_target_security" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/system_tab_text" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:orientation="horizontal" android:baselineAligned="false">
                <TextView android:id="@+id/wifi_target_channel_metric" style="@style/WifiTargetMetric"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <TextView android:id="@+id/wifi_target_signal_metric" style="@style/WifiTargetMetric"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp" />
                <TextView android:id="@+id/wifi_target_clients_metric" style="@style/WifiTargetMetric"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp" />
            </LinearLayout>
            <TextView android:id="@+id/wifi_target_adapter" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/system_tab_text" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="@string/wifi_target_actions"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
                <com.google.android.material.card.MaterialCardView android:id="@+id/wifi_target_capture_mode"
                    style="@style/WifiActionCard" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    android:contentDescription="@string/wifi_capture_action">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="112dp" android:padding="12dp" android:gravity="center"
                        android:drawablePadding="8dp" android:text="@string/wifi_capture_action"
                        app:drawableTopCompat="@drawable/ic_download" app:drawableTint="@color/system_accent"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/wifi_target_deauth_mode"
                    style="@style/WifiActionCard" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_marginStart="6dp"
                    android:contentDescription="@string/wifi_deauth_action">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="112dp" android:padding="12dp" android:gravity="center"
                        android:drawablePadding="8dp" android:text="@string/wifi_deauth_mode"
                        app:drawableTopCompat="@drawable/ic_wifi_deauth" app:drawableTint="@color/system_accent"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView android:id="@+id/wifi_target_pmkid_mode"
                style="@style/WifiActionCard" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:contentDescription="@string/wifi_pmkid_action">
                <androidx.appcompat.widget.AppCompatTextView android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="72dp" android:padding="12dp"
                    android:gravity="center" android:drawablePadding="8dp" android:text="@string/wifi_pmkid_action"
                    app:drawableStartCompat="@drawable/ic_wifi_capture" app:drawableTint="@color/system_accent"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/wifi_target_mode_help" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/system_tab_text" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/wifi_target_client_field"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:hint="@string/wifi_target_client_label" app:boxStrokeColor="@color/wifi_field_stroke" app:endIconTint="@color/system_accent">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/wifi_target_client"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                    android:inputType="none" android:fontFamily="monospace" android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/wifi_target_client_help" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/system_tab_text" />
            <com.google.android.material.button.MaterialButton android:id="@+id/wifi_target_scan_clients"
                style="@style/Tech.Button.Outlined" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:orientation="horizontal" android:baselineAligned="false">
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginEnd="6dp" android:hint="@string/wifi_channel" app:boxStrokeColor="@color/wifi_field_stroke">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/wifi_target_channel"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number"
                        android:maxLength="3" android:imeOptions="actionNext" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="6dp" android:hint="@string/wifi_target_seconds" app:boxStrokeColor="@color/wifi_field_stroke">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/wifi_target_duration"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number"
                        android:maxLength="3" android:imeOptions="actionDone" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="@string/wifi_target_time_limit" android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/system_tab_text" />
            <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/wifi_target_assist"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:minHeight="48dp" android:text="@string/wifi_assist" app:buttonTint="@color/system_accent" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/wifi_session_help" android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/system_tab_text" />
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp" android:orientation="vertical">
        <TextView android:id="@+id/wifi_target_footer_network" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/wifi_target_footer_client" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/system_tab_text"
            android:accessibilityLiveRegion="polite" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
            <com.google.android.material.button.MaterialButton android:id="@+id/wifi_target_cancel" style="@style/Tech.Button.Outlined"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:minHeight="48dp" android:text="@string/wifi_cancel" />
            <com.google.android.material.button.MaterialButton android:id="@+id/wifi_target_start" style="@style/Tech.Button.Primary"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp"
                android:minHeight="48dp" android:text="@string/wifi_start_capture" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
